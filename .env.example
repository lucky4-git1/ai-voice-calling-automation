# Server Configuration
PORT=4000
NODE_ENV=development
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000

# Database
# For SQLite (default local development, zero-dependency):
DATABASE_URL="file:./dev.db"
# For PostgreSQL (Docker / Production):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/callagent?schema=public"

# Redis & Queues
REDIS_URL="redis://localhost:6379"

# Security & Authentication
JWT_SECRET="e9a8f27c3d1b4a5e8f0123456789abcdef0123456789abcdef0123456789abcdef"
JWT_EXPIRES_IN="7d"
ENCRYPTION_KEY="01234567890123456789012345678901" # Exactly 32 characters for AES-256

# AI Voice & Telephony Providers (Leave empty to use Dev/Mock adapters with full simulation)
OPENAI_API_KEY=""
DEEPGRAM_API_KEY=""
ELEVENLABS_API_KEY=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TELNYX_API_KEY=""

# Billing & Payments
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# S3 / Object Storage
S3_BUCKET_NAME="callagent-recordings"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
